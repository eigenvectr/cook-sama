# Copy to .env and fill in. Never commit .env.

# SQLite in dev; a Postgres connection string in production (see docs/deploy.md)
DATABASE_URL="file:./dev.db"

# Single-owner login
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="change-me"

# Secret for signing the session cookie (32+ random chars)
AUTH_SECRET="generate-with: openssl rand -base64 32"

# AI photo import (optional in dev — the import page explains if missing)
ANTHROPIC_API_KEY=""

# Vercel Blob storage in production; omitted in dev (files go to public/uploads)
# BLOB_READ_WRITE_TOKEN=""
